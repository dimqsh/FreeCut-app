{
  "schema": 1,
  "id": "fc.clip.loop.spin",
  "kind": "loop",
  "units": null,
  "directions": ["clockwise", "counter-clockwise"],
  "default_duration_ms": 2000,
  "easing": "linear",
  "pivot": "anchor",
  "channels": [
    {
      "property": "rotate",
      "curve": {
        "type": "sampled",
        "points": [[0.0, 0.0], [1.0, 1.0]],
        "eased": false
      },
      "amplitude": 360.0,
      "unit": "deg",
      "scales_with_intensity": false
    }
  ]
}
