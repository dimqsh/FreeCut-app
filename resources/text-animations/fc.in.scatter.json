{
  "schema": 1,
  "id": "fc.in.scatter",
  "kind": "entrance",
  "units": ["letter"],
  "directions": null,
  "default_duration_ms": 1000,
  "easing": "ease-out-quad",
  "pivot": "anchor",
  "defaults": { "overlap": 800, "order": "random", "pace_ms": null },
  "channels": [
    {
      "property": "opacity",
      "curve": { "type": "eased" },
      "amplitude": -1.0,
      "unit": "ratio",
      "scales_with_intensity": false
    },
    {
      "property": "random.offset",
      "curve": { "type": "eased" },
      "amplitude": 1.5,
      "unit": "em",
      "scales_with_intensity": true
    },
    {
      "property": "random.rotate",
      "curve": { "type": "eased" },
      "amplitude": 40.0,
      "unit": "deg",
      "scales_with_intensity": true
    }
  ]
}
